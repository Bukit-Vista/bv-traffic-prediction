# Replace traffic.example.com before deployment.
traffic.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000"
	}

	log {
		output file /var/log/caddy/bali-traffic-access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
