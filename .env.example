APP_TIMEZONE=Asia/Makassar
DASHBOARD_DEMO_MODE=false
HERE_SOURCE_CUTOVER_ENABLED=true
BALI_SOURCE_DASHBOARD_ENABLED=true
AIRPORT_TOURISM_ROUTES_ENABLED=true
MOBILITY_SHADOW_READ_ENABLED=true
MOBILITY_SHADOW_UI_ENABLED=true
MOBILITY_PLACES_LAYER_ENABLED=true
# Authorized internal preview; independent from the public rollout.
MOBILITY_CATCHMENT_SHADOW_UI_ENABLED=false
MOBILITY_CATCHMENT_SHADOW_UI_FLAG_ACTOR=
# Public gravity-here-v2 rollout. Enable only after release:gate:mobility-v2
# passes and the database latest-run view reports public_serving_enabled = 1.
MOBILITY_CATCHMENT_V2_PUBLIC_ENABLED=false
MOBILITY_CATCHMENT_V2_PUBLIC_FLAG_ACTOR=
DASHBOARD_CONDITIONAL_CACHE_ENABLED=true
# Shared compressed JSON/GeoJSON cache. Use rediss:// when TLS is enabled on
# ElastiCache. REDIS_CACHE_REQUIRED makes the health check fail if Redis is down.
REDIS_URL=redis://redis:6379
REDIS_CACHE_ENABLED=false
REDIS_CACHE_REQUIRED=false
REDIS_CACHE_NAMESPACE=bali-traffic
REDIS_CACHE_TTL_LATEST_SECONDS=60
REDIS_CACHE_TTL_HISTORICAL_SECONDS=86400
REDIS_CACHE_MAX_VALUE_BYTES=8388608
REDIS_CONNECT_TIMEOUT_MS=2000
ROUTE_READ_CONTRACT_FALLBACK_ENABLED=true
# Set true only after api_airport_route_history_v1 and api_airport_route_geometry_v1 are deployed.
STEP3_ROUTE_VIEWS_REQUIRED=false
MVP_HISTORY_VIEWS_REQUIRED=false
OPERATIONS_API_TOKEN=
API_RATE_LIMIT_ENABLED=true
CORS_ALLOWED_ORIGINS=
MYSQL_CONNECTION_LIMIT=6
MYSQL_QUERY_TIMEOUT_MS=15000
BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BASEMAP_ATTRIBUTION="© OpenStreetMap contributors"
BASEMAP_DEPLOYMENT_MODE=demo-internal
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
REDIS_TRAFFIC_CACHE_MODE=prefer
REDIS_TRAFFIC_SNAPSHOT_TTL_SECONDS=172800
SNAPSHOT_REFRESH_INTERVAL_MINUTES=30
SNAPSHOT_REFRESH_OFFSET_MINUTES=12
REDIS_TRAFFIC_MAX_DASHBOARD_BYTES=8388608
REDIS_TRAFFIC_MAX_TILE_BYTES=2097152
REDIS_TRAFFIC_MAX_TOTAL_BYTES=335544320
